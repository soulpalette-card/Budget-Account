# ===== 大白话说明 =====
# 这个文件告诉 git 哪些东西【不要】上传到仓库。
# 最重要的一行是 .env —— 里面放的是你的 Supabase 密钥，绝对不能上传！

# 依赖包（几万个文件，不用传，别人 npm install 就有）
node_modules/

# 打包产物
dist/
dist-ssr/
*.local

# TypeScript 增量编译 / 生成产物（tsc -b 自动生成的，不用上传）
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# 环境变量文件（放密钥的，绝对不能传！）
.env
.env.local
.env.*.local

# 编辑器 / 系统杂七杂八的文件
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
